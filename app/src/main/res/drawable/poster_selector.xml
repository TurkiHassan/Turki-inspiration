<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="#132A4C" />
            <stroke
                android:width="2.5dp"
                android:color="#2F9BFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="#132A4C" />
            <stroke
                android:width="2.5dp"
                android:color="#2F9BFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="#132A4C" />
            <stroke
                android:width="2.5dp"
                android:color="#2F9BFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="#0B121F" />
            <stroke
                android:width="1dp"
                android:color="#1A2638" />
        </shape>
    </item>
</selector>
