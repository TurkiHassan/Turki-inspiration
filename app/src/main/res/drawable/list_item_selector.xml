<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#16304F" />
            <stroke
                android:width="2dp"
                android:color="#2F9BFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#122642" />
            <stroke
                android:width="1.5dp"
                android:color="#802F9BFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#16304F" />
            <stroke
                android:width="2dp"
                android:color="#2F9BFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="#000E182C" />
        </shape>
    </item>
</selector>
